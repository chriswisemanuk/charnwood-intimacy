---
interface Props {
  title: string;
  variant?: 'white' | 'alt' | 'blush';
}
const { title, variant = 'alt' } = Astro.props;
---
<section class={`section section--${variant}`}>
  <div class="container">
    <div class="info-inner">
      <h2>{title}</h2>
      <div class="info-body">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .info-inner {
    max-width: 880px;
  }
  .info-body :global(p) {
    font-size: 1.08rem;
    color: var(--text-soft);
  }
  .info-body :global(ul) {
    display: grid;
    gap: 0.7em 40px;
    padding-left: 1.3em;
    font-size: 1.05rem;
    color: var(--text-soft);
  }

  /* Long lists read better as two columns on wide screens, and it stops a
     tall single column leaving a large gap before the next section. */
  @media (min-width: 900px) {
    .info-body :global(ul) {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
