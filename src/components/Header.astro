---
import { conditions } from '../data/conditions';
import { BOOKING_URL } from '../consts';

const navLinks = [
  { href: '/your-therapist/', label: 'Your Therapist' },
  { href: '/what-to-expect/', label: 'What to Expect' },
  { href: '/pricing-and-booking/', label: 'Pricing & Booking' },
  { href: '/our-space/', label: 'Our Space' },
  { href: '/online-therapy/', label: 'Online Therapy' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link" aria-label="Charnwood Intimacy home">
      <img src="/images/logo-intimacy-header.png" alt="Charnwood Intimacy, part of the Charnwood Counselling group" width="1698" height="430" />
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="visually-hidden">Toggle navigation</span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <nav class="primary-nav" id="primary-nav">
      <ul>
        <li class="has-dropdown">
          <a href="/what-we-help-with/">What We Help With</a>
          <ul class="dropdown">
            {conditions.map((c) => (
              <li><a href={`/${c.slug}/`}>{c.navLabel}</a></li>
            ))}
          </ul>
        </li>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <a href={BOOKING_URL} class="btn btn-primary nav-cta">Book a session</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--teal-dark);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 14px rgba(4, 28, 31, 0.35);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px clamp(20px, 3vw, 44px);
    gap: 16px;
    flex-wrap: nowrap;
  }

  .logo-link {
    flex-shrink: 0;
    line-height: 0;
  }

  .logo-link img {
    height: 84px;
    width: auto;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: nowrap;
  }

  .primary-nav > ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  .primary-nav > ul > li > a {
    display: inline-block;
    padding: 10px 0;
    color: var(--white);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .primary-nav > ul > li > a:hover {
    color: var(--lime);
  }

  .has-dropdown {
    position: relative;
  }

  /* Invisible bridge so the cursor can cross the gap to the menu */
  .has-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -12px;
    right: -12px;
    height: 18px;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--white);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 30px rgba(0,0,0,0.18);
    list-style: none;
    margin: 12px 0 0 0;
    padding: 10px;
    min-width: 300px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0s linear 0.35s;
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0.06s, 0.06s, 0.06s;
  }

  .dropdown li a {
    display: block;
    padding: 10px 14px;
    color: var(--text);
    font-family: var(--font-body);
    font-weight: 500;
    border-radius: 6px;
    font-size: 0.94rem;
  }

  .dropdown li a:hover {
    background: var(--cream-alt);
    color: var(--orange);
  }

  .nav-cta {
    padding: 0.6em 1.3em;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .nav-toggle-bar {
    width: 26px;
    height: 3px;
    background: var(--white);
    border-radius: 2px;
  }

  @media (max-width: 1300px) {
    .nav-toggle {
      display: flex;
    }

    .primary-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--teal-dark);
      flex-direction: column;
      align-items: stretch;
      padding: 12px 24px 24px;
      gap: 0;
      box-shadow: 0 14px 20px rgba(4, 28, 31, 0.3);
    }

    .primary-nav.is-open {
      display: flex;
    }

    .primary-nav > ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      width: 100%;
      flex-wrap: nowrap;
    }

    .primary-nav > ul > li {
      width: 100%;
      border-bottom: 1px solid rgba(255,255,255,0.12);
    }

    .primary-nav > ul > li > a {
      display: block;
      padding: 14px 4px;
      font-size: 1rem;
    }

    .has-dropdown::after {
      display: none;
    }

    .dropdown {
      display: none;
      position: static;
      box-shadow: none;
      background: rgba(255,255,255,0.06);
      margin: 0 0 8px 0;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: none;
    }

    .has-dropdown.is-open .dropdown {
      display: block;
    }

    .dropdown li a {
      color: var(--text-on-dark);
    }

    .dropdown li a:hover {
      background: rgba(255,255,255,0.12);
      color: var(--lime);
    }

    .nav-cta {
      margin-top: 14px;
      align-self: flex-start;
    }
  }

  @media (max-width: 480px) {
    .logo-link img {
      height: 60px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  if (window.matchMedia('(max-width: 1300px)').matches) {
    document.querySelectorAll('.has-dropdown > a').forEach((link) => {
      link.addEventListener('click', (e) => {
        const parent = link.parentElement;
        if (parent && !parent.classList.contains('is-open')) {
          e.preventDefault();
          document.querySelectorAll('.has-dropdown.is-open').forEach((el) => el.classList.remove('is-open'));
          parent.classList.add('is-open');
        }
      });
    });
  }
</script>
