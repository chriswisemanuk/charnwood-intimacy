---
interface Props {
  color?: string;
  class?: string;
}
const { color = 'var(--coral)', class: klass = '' } = Astro.props;
---
<svg class={`underline-swoosh ${klass}`} viewBox="0 0 90 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M3 6C20 -1 40 13 87 6" stroke={color} stroke-width="4" stroke-linecap="round"/>
</svg>
