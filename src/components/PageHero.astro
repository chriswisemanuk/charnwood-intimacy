---
import CTAButton from './CTAButton.astro';
import Squiggle from './Squiggle.astro';
import WaveDivider from './WaveDivider.astro';
import { BOOKING_URL } from '../consts';

interface Props {
  kicker?: string;
  title: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string;
  imageAlt?: string;
  /* Animated SVG illustration with a static version served when the
     visitor prefers reduced motion */
  illustration?: string;
  illustrationStatic?: string;
}

const {
  kicker,
  title,
  ctaLabel = 'Book a session',
  ctaHref = BOOKING_URL,
  secondaryLabel,
  secondaryHref,
  image,
  imageAlt = '',
  illustration,
  illustrationStatic,
} = Astro.props;

const hasVisual = !!(image || illustration);
---
<section class="page-hero">
  <div class:list={['container', { 'hero-with-image': hasVisual }]}>
    <div class="page-hero-copy">
      {kicker && <p class="eyebrow">{kicker}</p>}
      <h1>{title}</h1>
      <Squiggle />
      <div class="page-hero-body">
        <slot />
      </div>
      <div class="page-hero-actions">
        <CTAButton href={ctaHref} variant="primary">{ctaLabel}</CTAButton>
        {secondaryLabel && secondaryHref && (
          <CTAButton href={secondaryHref} variant="link">{secondaryLabel}</CTAButton>
        )}
      </div>
    </div>
    {illustration ? (
      <div class="page-hero-image page-hero-illustration framed-photo">
        <picture>
          {illustrationStatic && (
            <source srcset={illustrationStatic} media="(prefers-reduced-motion: reduce)" />
          )}
          <img src={illustration} alt="" width="680" height="500" loading="lazy" />
        </picture>
      </div>
    ) : image ? (
      <div class="page-hero-image framed-photo">
        <img src={image} alt={imageAlt} width="1100" height="733" />
      </div>
    ) : null}
  </div>
</section>
<WaveDivider from="var(--cream)" to="var(--white)" />

<style>
  .page-hero {
    background: var(--cream);
    padding: 64px 0 60px;
  }

  .hero-with-image {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  .page-hero h1 {
    max-width: 780px;
  }

  .page-hero-body {
    max-width: 720px;
    font-size: 1.15rem;
    color: var(--text-soft);
  }

  .page-hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .page-hero-image img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .page-hero-illustration img {
    aspect-ratio: 680 / 500;
    object-fit: cover;
    /* No background. Each illustration carries its own blush panel with
       matching 16px rounded corners, so a background here only shows as a
       pale sliver at the edges when the box and the artwork do not round to
       the same pixel. */
    background: transparent;
  }

  @media (max-width: 860px) {
    .hero-with-image {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
