---
import CTAButton from './CTAButton.astro';
import Squiggle from './Squiggle.astro';
import WaveDivider from './WaveDivider.astro';
import { BOOKING_URL } from '../consts';

interface Props {
  kicker?: string;
  title: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  image?: string;
  imageAlt?: string;
}

const {
  kicker,
  title,
  ctaLabel = 'Book a session',
  ctaHref = BOOKING_URL,
  secondaryLabel,
  secondaryHref,
  image,
  imageAlt = '',
} = Astro.props;
---
<section class="page-hero">
  <div class:list={['container', { 'hero-with-image': !!image }]}>
    <div class="page-hero-copy">
      {kicker && <p class="eyebrow">{kicker}</p>}
      <h1>{title}</h1>
      <Squiggle />
      <div class="page-hero-body">
        <slot />
      </div>
      <div class="page-hero-actions">
        <CTAButton href={ctaHref} variant="primary">{ctaLabel}</CTAButton>
        {secondaryLabel && secondaryHref && (
          <CTAButton href={secondaryHref} variant="link">{secondaryLabel}</CTAButton>
        )}
      </div>
    </div>
    {image && (
      <div class="page-hero-image framed-photo">
        <img src={image} alt={imageAlt} width="1100" height="733" />
      </div>
    )}
  </div>
</section>
<WaveDivider from="var(--cream)" to="var(--white)" />

<style>
  .page-hero {
    background: var(--cream);
    padding: 64px 0 60px;
  }

  .hero-with-image {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }

  .page-hero h1 {
    max-width: 780px;
  }

  .page-hero-body {
    max-width: 720px;
    font-size: 1.15rem;
    color: var(--text-soft);
  }

  .page-hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .page-hero-image img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  @media (max-width: 860px) {
    .hero-with-image {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
