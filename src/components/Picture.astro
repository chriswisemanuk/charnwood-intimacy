---
/*
  Serves WebP to browsers that support it, with the original JPEG or PNG as a
  fallback for everything else. A .webp sibling must exist next to the source
  file. SVGs are passed straight through, since they are already vector.
*/
interface Props {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  [key: string]: any;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority,
  class: klass,
  ...rest
} = Astro.props;

const isRaster = /\.(jpe?g|png)$/i.test(src);
const webp = src.replace(/\.(jpe?g|png)$/i, '.webp');
---
{isRaster ? (
  <picture>
    <source srcset={webp} type="image/webp" />
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      class={klass}
      {...rest}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    class={klass}
    {...rest}
  />
)}
