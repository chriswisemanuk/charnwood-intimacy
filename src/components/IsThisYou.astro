---
interface Props {
  title?: string;
  items: string[];
}
const { title = 'Is this you?', items } = Astro.props;
---
<section class="section section--white">
  <div class="container">
    <h2>{title}</h2>
    <ul class="check-list is-this-you-list">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .is-this-you-list {
    max-width: 820px;
    font-size: 1.08rem;
  }
</style>
