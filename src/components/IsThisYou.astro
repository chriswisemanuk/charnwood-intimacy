---
interface Props {
  title?: string;
  items: string[];
}
const { title = 'Is this you?', items } = Astro.props;
---
<section class="section section--white">
  <div class="container">
    <h2>{title}</h2>
    <ul class="check-list is-this-you-list">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .is-this-you-list {
    max-width: 820px;
    font-size: 1.08rem;
  }

  @media (min-width: 900px) {
    .is-this-you-list {
      max-width: 100%;
      grid-template-columns: 1fr 1fr;
      gap: 0.9em 40px;
    }
  }
</style>
