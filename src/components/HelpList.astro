---
interface Props {
  title?: string;
  items: string[];
}
const { title = 'How therapy can help', items } = Astro.props;
---
<section class="section section--white">
  <div class="container">
    <div class="help-card card--dark">
      <h3>{title}</h3>
      <ul class="check-list">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .help-card {
    max-width: 780px;
  }
</style>
