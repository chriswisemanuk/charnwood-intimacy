---
/*
  "What can cause / contribute to this" and "How therapy can help" sit side by
  side on desktop and stack on mobile. Previously two separate stacked
  sections, which left a large empty gap on wide screens.
*/
interface Props {
  causesTitle: string;
  causes: string[];
  helpTitle?: string;
  help: string[];
}
const { causesTitle, causes, helpTitle = 'How therapy can help', help } = Astro.props;
---
<section class="section section--white">
  <div class="container">
    <div class="pair">
      <div class="causes">
        <h2>{causesTitle}</h2>
        <ul>
          {causes.map((c) => <li>{c}</li>)}
        </ul>
      </div>

      <div class="help card--dark">
        <h3>{helpTitle}</h3>
        <ul class="check-list">
          {help.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .pair {
    display: grid;
    gap: 32px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
  }

  .causes h2 {
    margin-bottom: 0.7em;
  }

  .causes ul {
    display: grid;
    gap: 0.7em;
    padding-left: 1.3em;
    margin: 0;
    font-size: 1.05rem;
    color: var(--text-soft);
  }

  .help {
    /* the dark card carries its own padding from .card--dark */
    align-self: start;
  }

  .help h3 {
    margin-bottom: 0.8em;
  }
</style>
