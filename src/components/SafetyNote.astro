---
interface Props {
  title?: string;
}
const { title = 'A note on safety and accuracy' } = Astro.props;
---
<section class="section--tight section--alt">
  <div class="container">
    <div class="safety-note">
      <h3>{title}</h3>
      <div><slot /></div>
    </div>
  </div>
</section>

<style>
  .safety-note {
    max-width: 780px;
    border-left: 4px solid var(--coral);
    padding-left: 24px;
  }
  .safety-note :global(p) {
    color: var(--text-soft);
    margin-bottom: 0;
  }
</style>
