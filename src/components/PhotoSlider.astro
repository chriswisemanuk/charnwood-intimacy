---
/*
  Full-width, edge-to-edge photo slider (Self Space-style), using CSS
  scroll-snap with previous/next buttons. No external libraries.
*/
interface Props {
  photos: { src: string; alt: string }[];
  onDark?: boolean;
}
const { photos, onDark = false } = Astro.props;
const sliderId = `slider-${Math.random().toString(36).slice(2, 8)}`;
---
<div class:list={['photo-slider-wrap', { 'on-dark': onDark }]}>
  <div class="photo-slider" id={sliderId} tabindex="0" aria-label="Photo gallery, scroll or use the arrow buttons">
    {photos.map((p) => (
      <div class="slide">
        <img src={p.src} alt={p.alt} loading="lazy" width="1100" height="733" />
      </div>
    ))}
  </div>
  <div class="slider-controls">
    <button class="slider-btn" data-slider={sliderId} data-dir="-1" aria-label="Previous photos">&larr;</button>
    <button class="slider-btn" data-slider={sliderId} data-dir="1" aria-label="Next photos">&rarr;</button>
  </div>
</div>

<style>
  .photo-slider-wrap {
    width: 100%;
    position: relative;
  }

  .photo-slider {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 8px clamp(20px, 4vw, 60px) 8px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .photo-slider::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 auto;
    width: min(480px, 80vw);
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    scroll-snap-align: center;
    box-shadow: 0 12px 30px rgba(15, 68, 74, 0.16);
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .slide:hover img {
    transform: scale(1.04);
  }

  .slider-controls {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    padding: 14px clamp(20px, 4vw, 60px) 0;
  }

  .slider-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--teal-dark);
    background: transparent;
    color: var(--teal-dark);
    font-size: 1.2rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .slider-btn:hover {
    background: var(--teal-dark);
    color: var(--white);
    transform: translateY(-2px);
  }

  .on-dark .slider-btn {
    border-color: var(--white);
    color: var(--white);
  }

  .on-dark .slider-btn:hover {
    background: var(--white);
    color: var(--teal-dark);
  }
</style>

<script>
  document.querySelectorAll('.slider-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slider = document.getElementById(btn.getAttribute('data-slider') || '');
      if (!slider) return;
      const dir = Number(btn.getAttribute('data-dir') || '1');
      slider.scrollBy({ left: dir * slider.clientWidth * 0.75, behavior: 'smooth' });
    });
  });
</script>
