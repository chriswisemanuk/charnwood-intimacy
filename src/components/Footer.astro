---
import { PHONE, PHONE_HREF, EMAIL, EMAIL_HREF, ADDRESS_LINES, PARENT_SITE_URL, PARENT_SITE_NAME } from '../consts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/images/logo-intimacy-small.png" alt="Charnwood Intimacy" width="200" height="66" />
      <p class="footer-tagline">Psychosexual &amp; Intimacy Therapy in Loughborough, and online across the UK.</p>
      <p class="footer-contact">
        <a href={PHONE_HREF}>{PHONE}</a><br />
        <a href={EMAIL_HREF}>{EMAIL}</a>
      </p>
    </div>

    <div class="footer-col">
      <h4>Policies</h4>
      <ul>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/cookie-policy/">Cookie Policy</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>More</h4>
      <ul>
        <li><a href="/resources/">Resources</a></li>
        <li><a href={PARENT_SITE_URL} target="_blank" rel="noopener">{PARENT_SITE_NAME}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Find us</h4>
      <p class="address">
        {ADDRESS_LINES.map((line) => <>{line}<br /></>)}
      </p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>Copyright &copy; {year} | Charnwood Intimacy | Part of the Charnwood Counselling group | {ADDRESS_LINES.join(' | ')} | {PHONE}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal-dark);
    color: var(--text-on-dark-soft);
    padding: 56px 0 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  .footer-brand img {
    margin-bottom: 14px;
  }

  .footer-tagline {
    max-width: 320px;
    color: var(--text-on-dark-soft);
  }

  .footer-contact a {
    color: var(--white);
    font-weight: 600;
  }

  .footer-contact a:hover {
    color: var(--lime);
  }

  .footer-col h4 {
    color: var(--white);
    font-size: 1rem;
    margin-bottom: 0.9em;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6em;
  }

  .footer-col a {
    color: var(--text-on-dark-soft);
  }

  .footer-col a:hover {
    color: var(--lime);
  }

  .address {
    color: var(--text-on-dark-soft);
    margin: 0;
  }

  .footer-bottom {
    padding: 20px 24px 24px;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.82rem;
    color: rgba(245,247,242,0.65);
  }

  @media (max-width: 860px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
