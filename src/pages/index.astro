---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import ConditionsGrid from '../components/ConditionsGrid.astro';
import OurSpaceSection from '../components/OurSpaceSection.astro';
import PricingBookingSection from '../components/PricingBookingSection.astro';
import ContactForm from '../components/ContactForm.astro';
import Picture from '../components/Picture.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { BOOKING_URL } from '../consts';
import { localBusiness } from '../data/schema';

const isThisYou = [
  "I experience pain during sex and I've been told nothing is physically wrong",
  "I've lost interest in sex and I don't know why",
  "I feel so anxious about sex that I avoid it altogether",
  'My relationship is suffering because of a sexual difficulty',
  "I've never really enjoyed sex and I'm starting to wonder if something is wrong",
  'Sex has changed since I had a baby, went through menopause, or became unwell',
  "I want to talk about something that happened to me and how it's affecting me now",
  "I feel ashamed of my desires and don't know who to talk to",
  "My partner and I want to work through this together but don't know where to start",
  'I just want to feel normal again',
];

const howCanHelp = [
  'Understand the physical, emotional and relational factors behind your difficulties',
  'Reduce anxiety and self-consciousness around sex and intimacy',
  'Process past experiences at a pace that feels safe',
  'Reconnect with your body and your own desires',
  'Communicate more openly with a partner about needs, boundaries and concerns',
  'Develop a more accepting, compassionate relationship with your sexuality',
  'Feel less alone with experiences that are rarely spoken about',
];
---
<BaseLayout
  title="Sex & Psychosexual Therapy Loughborough | Charnwood Intimacy"
  description="Confidential sex therapy and psychosexual therapy in Loughborough and online across the UK. Support for low desire, painful sex, sexual trauma and more."
  path="/"
  schema={[localBusiness]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="display">
          Your body,
          <span class="hand-underline">
            your space
            <svg viewBox="0 0 300 24" aria-hidden="true" preserveAspectRatio="none">
              <path d="M5 16 C 75 6 150 19 220 11 C 250 8 275 10 295 13" />
            </svg>
          </span>.
        </h1>
        <p class="hero-sub">Psychosexual &amp; Intimacy Therapy in Loughborough, and online across the UK.</p>
        <p class="hero-lead">
          Sex and intimacy touch almost every part of who we are, yet they're often the hardest
          things to talk about, even with a doctor, a partner, or someone we trust. Charnwood
          Intimacy offers a private, non-judgemental space to work through the sexual and
          relational difficulties that are affecting your life.
        </p>
        <CTAButton href={BOOKING_URL} variant="primary">Book a session</CTAButton>
      </div>
      <div class="hero-image">
        <div class="framed-photo hero-illustration">
          <picture>
            <source srcset="/images/illustrations/static/therapy-room.svg" media="(prefers-reduced-motion: reduce)" />
            <img src="/images/illustrations/therapy-room.svg" alt="" width="680" height="460" fetchpriority="high" />
          </picture>
        </div>
        <img class="hero-badge" src="/images/fox-badge.png" alt="" aria-hidden="true" width="480" height="480" />
      </div>
    </div>
  </section>

  <WaveDivider from="var(--cream)" to="var(--white)" />

  <section class="section section--white">
    <div class="container">
      <h2>Is psychosexual therapy for me?</h2>
      <p class="section-intro">
        People come to sex therapy, also called psychosexual therapy, for all sorts of reasons. Sometimes there's a clear
        issue, and other times it's just a sense that something isn't quite right. Here are some
        of the things we often hear:
      </p>
      <ul class="check-list is-this-you-grid">
        {isThisYou.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <WaveDivider from="var(--white)" to="var(--teal-dark)" flip />

  <section class="section section--dark">
    <div class="container">
      <p class="eyebrow">How can therapy help?</p>
      <h2>Ways we can work together</h2>
      <ul class="check-list help-grid">
        {howCanHelp.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <WaveDivider from="var(--teal-dark)" to="var(--blush)" />

  <section class="section section--blush">
    <div class="container">
      <p class="eyebrow">Why Charnwood Intimacy?</p>
      <h2>A space made for these conversations</h2>
      <div class="feature-trio">
        <div class="feature-card">
          <div class="feature-icon" style="background: var(--blush-deep);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="var(--coral)" aria-hidden="true">
              <path d="M12 21s-7.5-4.7-10-9.3C.4 8.6 2.3 5 5.7 5c2 0 3.4 1.1 4.3 2.6h4c.9-1.5 2.3-2.6 4.3-2.6 3.4 0 5.3 3.6 3.7 6.7C19.5 16.3 12 21 12 21z" transform="scale(0.9) translate(1.3,1.3)"/>
            </svg>
          </div>
          <h3>A specialist space</h3>
          <p>
            A dedicated home for psychosexual and intimacy therapy, with room to talk about the
            things that are often hardest to say anywhere else.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" style="background: var(--cream-alt);">
            <img src="/images/fox-counselling.png" alt="" width="56" height="56" style="border-radius: 50%;" />
          </div>
          <h3>Part of Charnwood Counselling</h3>
          <p>
            The same warm team and calm, private rooms at The Old Arts College that Charnwood
            Counselling clients already know.
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon" style="background: var(--blush-deep);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 11l9-8 9 8"/><path d="M5 9.5V20h5v-6h4v6h5V9.5"/>
            </svg>
          </div>
          <h3>In person or online</h3>
          <p>
            Sessions in the heart of Loughborough or online anywhere in the UK, whichever
            feels more comfortable for you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider from="var(--blush)" to="var(--cream-alt)" flip />

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">What we help with</p>
      <h2>What we can work through together</h2>
      <p class="section-intro">
        Psychosexual therapy is a specialist form of talking therapy focused on sexual health,
        intimacy and the relational side of sexual experience.
      </p>
      <ConditionsGrid />
      <div class="see-all">
        <CTAButton href="/what-we-help-with/" variant="link">See everything we help with &rarr;</CTAButton>
      </div>
    </div>
  </section>

  <WaveDivider from="var(--cream-alt)" to="var(--white)" flip />

  <section class="section section--white">
    <div class="container therapist-grid">
      <div class="therapist-photo framed-photo">
        <Picture src="/images/jo-wiseman.jpg" alt="Jo Wiseman, Founder & Psychotherapist" width={700} height={875} />
      </div>
      <div>
        <p class="eyebrow">Meet your therapist</p>
        <h2>Jo Wiseman</h2>
        <p>
          Jo Wiseman is a warm, down-to-earth psychotherapist and the founder of Charnwood
          Counselling. She's currently completing her specialist training in psychosexual and
          relationship therapy, and brings the same grounded, non-judgemental presence to this
          work that she brings to everything else.
        </p>
        <CTAButton href="/your-therapist/" variant="link">More about your therapist &rarr;</CTAButton>
      </div>
    </div>
  </section>

  <WaveDivider from="var(--white)" to="var(--teal-dark)" />

  <OurSpaceSection />

  <WaveDivider from="var(--teal-dark)" to="var(--white)" flip />

  <PricingBookingSection />

  <WaveDivider from="var(--white)" to="var(--blush)" />

  <section class="section section--blush" id="contact">
    <div class="container">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--cream);
    padding: 72px 0 80px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-sub {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--teal-dark);
    margin: 0.4em 0 0.8em;
  }
  .hero-lead {
    font-size: 1.12rem;
    color: var(--text-soft);
    max-width: 560px;
  }
  .hero-image {
    position: relative;
    padding: 0 18px 18px 0;
  }
  .hero-illustration img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 18px 44px rgba(15, 68, 74, 0.22);
  }
  .hero-badge {
    position: absolute;
    bottom: -26px;
    left: -26px;
    width: 112px;
    height: 112px;
    border: 5px solid var(--cream);
    border-radius: 50%;
    box-shadow: 0 10px 24px rgba(15, 68, 74, 0.25);
  }
  .section-intro {
    max-width: 700px;
    font-size: 1.08rem;
    color: var(--text-soft);
  }
  .is-this-you-grid, .help-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9em 32px;
    max-width: 960px;
  }
  .see-all {
    margin-top: 32px;
  }
  .therapist-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 56px;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hero-grid, .therapist-grid {
      grid-template-columns: 1fr;
    }
    .therapist-photo {
      max-width: 320px;
    }
    .is-this-you-grid, .help-grid {
      grid-template-columns: 1fr;
    }
    .hero-badge {
      width: 84px;
      height: 84px;
      bottom: -14px;
      left: 12px;
    }
    .hero-image {
      padding: 0;
    }
  }
</style>
