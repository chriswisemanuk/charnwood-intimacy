---
import BaseLayout from '../layouts/BaseLayout.astro';
import Squiggle from '../components/Squiggle.astro';
import CTAButton from '../components/CTAButton.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { BOOKING_URL } from '../consts';

const gallery = [
  { src: '/images/our-space-room.jpg', alt: 'The main therapy room with sofas, plants and a large window' },
  { src: '/images/gallery/room-1.jpg', alt: 'A therapy room with the Charnwood fox on the door' },
  { src: '/images/gallery/room-3.jpg', alt: 'A cosy red armchair in the therapy room' },
  { src: '/images/gallery/room-2.jpg', alt: 'A mug of tea beside the fox cushion in the waiting area' },
  { src: '/images/gallery/room-6.jpg', alt: 'The Charnwood fox sign on the therapy room door' },
  { src: '/images/gallery/room-4.jpg', alt: 'Hand-made clay houses on a shelf in the therapy room' },
  { src: '/images/gallery/room-7.jpg', alt: 'A framed fox photograph on the wall' },
  { src: '/images/gallery/room-8.jpg', alt: 'The Old Arts College building in central Loughborough' },
];
---
<BaseLayout
  title="Our Space in Loughborough | Charnwood Intimacy"
  description="Charnwood Intimacy is based at The Old Arts College in central Loughborough, fully accessible, with sessions also available online."
  path="/our-space/"
>
  <section class="section section--white">
    <div class="container hero-grid-inner">
      <div>
        <p class="eyebrow">Our Space</p>
        <h1>Charnwood Intimacy at The Old Arts College, Loughborough</h1>
        <Squiggle />
        <p class="lead">
          We're located in the heart of Loughborough on the second floor of The Old Arts College,
          above Public and Plants. The room is cosy, private and fully accessible, in one of the
          town's most iconic buildings. There's excellent coffee nearby if you'd like time
          afterwards to sit with how the session felt.
        </p>
        <CTAButton href={BOOKING_URL} variant="primary">Book a session</CTAButton>
      </div>
      <div class="framed-photo">
        <img src="/images/our-space-room.jpg" alt="The therapy room at The Old Arts College, Loughborough" width="1600" height="1200" />
      </div>
    </div>
  </section>

  <WaveDivider from="var(--white)" to="var(--cream-alt)" />

  <section class="section section--alt gallery-section">
    <div class="container">
      <p class="eyebrow">Take a look around</p>
      <h2>A warm, private space to talk</h2>
      <div class="photo-grid">
        {gallery.map((p) => (
          <div class="photo">
            <img src={p.src} alt={p.alt} loading="lazy" width="1100" height="733" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <WaveDivider from="var(--cream-alt)" to="var(--white)" flip />

  <section class="section section--white getting-here">
    <div class="container">
      <h2>Getting here</h2>

      <div class="getting-here-grid">
        <div>
          <h3>Visiting us by public transport</h3>
          <p>
            We're easily reachable by bus. Bus stop AA (Ashby Square) is right outside with
            regular buses from Leicester, Shepshed, Birstall, Rothley, Mountsorrel, Quorn and
            Ashby-de-la-Zouch. This stop is also served by local KinchBus services, including
            buses every 10 minutes from Loughborough Railway Station and Loughborough University.
            Skylink Derby/Leicester and buses to Nottingham also stop less than 5 minutes walk
            away on Derby Road and Baxter Gate.
          </p>
        </div>
        <div>
          <h3>Visiting us by car</h3>
          <p>
            There are a number of car parks within a couple of minutes walk. Sainsbury's on Ashby
            Road offers up to 2 hours free parking, as does Regents Place Retail Park. Paid
            parking is also available at Packe Street and Granby Street car parks, whilst
            on-street parking is available in the surrounding area after 6pm.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .lead {
    font-size: 1.1rem;
    color: var(--text-soft);
    max-width: 560px;
  }
  .getting-here-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 24px;
  }
  .getting-here-grid p {
    color: var(--text-soft);
  }
  @media (max-width: 860px) {
    .hero-grid-inner, .getting-here-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
