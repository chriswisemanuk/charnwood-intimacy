---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IsThisYou from '../components/IsThisYou.astro';
import InfoSection from '../components/InfoSection.astro';
import CausesAndHelp from '../components/CausesAndHelp.astro';
import SafetyNote from '../components/SafetyNote.astro';
import MiniTeasers from '../components/MiniTeasers.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { service, breadcrumb } from '../data/schema';
---
<BaseLayout
  title="Sexual Trauma Therapy | Charnwood Intimacy"
  description="Trauma-informed therapy for the impact of sexual abuse, assault or coercion on your sex life, relationships and sense of self. Loughborough and online."
  path="/sexual-trauma-therapy/"
  schema={[
    service({
      name: "Sexual Trauma Therapy",
      description: "Trauma-informed therapy for the impact of sexual abuse, assault or coercion on your sex life, relationships and sense of self. Loughborough and online.",
      slug: "sexual-trauma-therapy",
    }),
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'What We Help With', path: '/what-we-help-with/' },
      { name: "Sexual Trauma", path: "/sexual-trauma-therapy/" },
    ]),
  ]}
>
  <PageHero kicker="Trauma-informed sex therapy" title="Sexual Trauma" illustration="/images/illustrations/sexual-trauma.svg" illustrationStatic="/images/illustrations/static/sexual-trauma.svg">
    <p>
      Past experiences of sexual abuse, assault or coercion can affect how safe sex and intimacy
      feel, sometimes for years afterwards. This is a trauma-informed space to work through what
      happened, at whatever pace feels right for you.
    </p>
  </PageHero>

  <IsThisYou
    items={[
      'I want to talk about something that happened to me and how it’s affecting me now',
      'I avoid sex or physical intimacy because of something in my past',
      'I feel disconnected, or like I leave my body, during sex',
      'I struggle to trust partners, even in a relationship where I feel loved',
      'I feel shame, guilt or confusion about what happened, even though I know it wasn’t my fault',
      "I'm not ready to talk about details, but I know it's affecting my life",
    ]}
  />

  <WaveDivider from="var(--white)" to="var(--cream-alt)" />

  <InfoSection title="How therapy approaches this">
    <p>
      This work is trauma-informed, meaning the pace, structure and depth are always led by you.
      You are never asked to share more than you're ready to, and there is no expectation to
      relive or describe events in detail before you feel able to. The aim is to help you
      understand the impact of what happened, and to find a way of relating to your body, your
      sexuality and your relationships that feels less controlled by the past.
    </p>
    <p>
      This applies whether the experience happened recently or many years ago, and whether it was
      a single event or something that happened over time, including in childhood.
    </p>
  </InfoSection>

  <WaveDivider from="var(--cream-alt)" to="var(--white)" flip />

  <CausesAndHelp
    causesTitle="Effects this work can help with"
    causes={[
      "Avoidance of sex or physical closeness",
      "Flashbacks, dissociation or feeling 'not present' during intimacy",
      "Difficulty feeling safe with a partner, even a trusted one",
      "Complicated feelings about your own sexuality since the experience",
      "Shame or self-blame that logically you know isn't fair, but still feels real",
    ]}
    help={[
      "A safe, paced space with no pressure to disclose more than feels right",
      "Understanding the lasting effects of trauma on the body and on intimacy",
      "Rebuilding a sense of safety and choice, in your body and in relationships",
      "Support alongside other help you may already be receiving",
    ]}
  />

  <WaveDivider from="var(--white)" to="var(--blush)" />

  <SafetyNote>
    <p>
      If you are in immediate danger or at risk of harm, please contact emergency services or a
      specialist helpline rather than waiting for a therapy appointment. Your therapist will also
      explain the limits of confidentiality clearly at the start of any work together,
      particularly around safeguarding.
    </p>
  </SafetyNote>

  <WaveDivider from="var(--blush)" to="var(--cream-alt)" flip />

  <MiniTeasers />
</BaseLayout>
