---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IsThisYou from '../components/IsThisYou.astro';
import InfoSection from '../components/InfoSection.astro';
import HelpList from '../components/HelpList.astro';
import MiniTeasers from '../components/MiniTeasers.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { service, breadcrumb } from '../data/schema';
---
<BaseLayout
  title="Couples & Intimacy Therapy | Charnwood Intimacy"
  description="Rebuild intimacy, communication and connection together. Sex therapy for couples in Loughborough and online, for all relationship structures."
  path="/couples-and-intimacy-therapy/"
  schema={[
    service({
      name: "Couples & Intimacy Therapy",
      description: "Rebuild intimacy, communication and connection together. Sex therapy for couples in Loughborough and online, for all relationship structures.",
      slug: "couples-and-intimacy-therapy",
    }),
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'What We Help With', path: '/what-we-help-with/' },
      { name: "Couples & Intimacy Therapy", path: "/couples-and-intimacy-therapy/" },
    ]),
  ]}
>
  <PageHero kicker="Couples, partners & relationships" title="Relationship & Intimacy Therapy" illustration="/images/illustrations/couples-intimacy.svg" illustrationStatic="/images/illustrations/static/couples-intimacy.svg">
    <p>
      Sexual and intimacy difficulties rarely exist on their own, they usually sit inside a
      relationship. Relationship and intimacy therapy, including sex therapy for couples, gives
      you and your partner or partners a structured, supported space to work through what's
      happening together.
    </p>
  </PageHero>

  <IsThisYou
    items={[
      'We want to work through this together but don’t know where to start',
      'We’ve drifted apart physically and emotionally',
      'One of us wants sex far more, or less, than the others',
      'We’re trying to rebuild trust and intimacy after a breach of trust',
      'Sex has changed since a baby, illness, menopause or another big life event',
      'We communicate badly about sex and it’s affecting everything else',
      'Our relationship doesn’t look like the ones therapy usually assumes, and we want a space that won’t judge that',
      'We’re navigating something specific to how our relationship is structured',
    ]}
  />

  <HelpList
    title="How therapy can help"
    items={[
      'Build a shared language for talking about sex, needs and boundaries',
      'Work through conflict, rupture and repair without it causing lasting damage',
      'Rebuild intimacy and trust after infidelity or a breach of trust',
      'Understand each other’s experience of desire, rather than assuming the worst',
      'Work through the particular questions that come with open, polyamorous or other non-monogamous relationships',
      'Find an approach that fits your relationship as it actually is, including LGBTQ+ relationships',
    ]}
  />

  <InfoSection title="Who this is for" variant="white">
    <p>
      This is for anyone wanting to work on a relationship, whatever shape that relationship
      takes. Most often that is two people, and much of what follows is written with couples in
      mind, because that is who most commonly comes. It is equally open to throuples, polyamorous
      and open relationships, and other consensually non-monogamous arrangements, and to people
      of any gender or sexuality.
    </p>
    <p>
      Not everyone in the relationship has to attend, and you don't need to come to every session
      together. Some people choose a mix of joint and individual sessions, and where more than two
      people are involved we will talk together about who attends what, so that everyone's voice
      has room.
    </p>
    <p>
      You will not be asked to justify how your relationship is structured, or treated as though
      the structure itself is the problem.
    </p>
  </InfoSection>

  <WaveDivider from="var(--white)" to="var(--cream-alt)" />

  <MiniTeasers />
</BaseLayout>
